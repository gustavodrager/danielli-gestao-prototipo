# Copiar para .env.local. Nunca versionar uma conexão real.
# API: conexão pooled do ambiente correspondente no Neon, com TLS verificado.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST-pooler.neon.tech/BANCO?sslmode=verify-full
# Opcional. Se definido, deve corresponder à origem usada pelos usuários.
# Não reutilizar a origem de produção nas prévias de homologação.
APP_ORIGIN=http://127.0.0.1:5173

# Para testes, definir somente em .env.test.local, apontando a banco de testes.
# DATABASE_URL_TEST=postgresql://USUARIO:SENHA@localhost:5432/danielli_test

# Ferramentas administrativas: conexão direta recomendada para pg_dump.
# SOURCE_DATABASE_URL=postgresql://USUARIO:SENHA@HOST.neon.tech/BANCO?sslmode=verify-full
# RESTORE_DATABASE_URL=postgresql://USUARIO:SENHA@OUTRO_HOST.neon.tech/BANCO_VAZIO?sslmode=verify-full
# pg_dump/pg_restore locais ou dentro de contêiner PostgreSQL compatível:
# PG_TOOL_CONTAINER=nome-do-container
# PG_TOOL_PORT=5432
